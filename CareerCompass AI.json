    {
      "id": "code-digest",
      "name": "Build Digest",
      "type": "n8n-nodes-base.code",
      "position": [
        4800,
        0
      ],
      "parameters": {
        "jsCode": "const jobs = $input.all()\n  .map((i) => i.json)\n  .filter((j) => Number(j.match_score) >= Number($env.CAREER_MIN_SCORE || 75))\n  .sort((a, b) => Number(b.match_score) - Number(a.match_score))\n  .slice(0, Number($env.CAREER_MAX_JOBS || 10));\nreturn jobs.length ? [{ json: { jobs, count: jobs.length } }] : [];"
      },
      "typeVersion": 2
    },
    {
      "id": "gmail-digest",
      "name": "Email Daily Digest",
      "type": "n8n-nodes-base.gmail",
      "position": [
        6720,
        0
      ],
      "parameters": {
        "sendTo": "={{ $env.JOBHUNT_EMAIL_TO || 'your@email.com' }}",
        "subject": "=CareerCompass AI - {{ $json.count }} strong matches ({{ $now.format('dd MMM yyyy') }})",
        "message": "={{ $json.jobs.map(j => `${j.title} @ ${j.company}\\nScore: ${j.match_score}/100 | ${j.location} | ${j.work_location}\\nApply: ${j.apply_url}\\nWhy: ${j.match_reasons}\\nMissing: ${j.missing_skills}\\nCover letter draft:\\n${j.cover_letter}`).join('\\n\\n---\\n\\n') }}",
        "options": {},
        "emailType": "text"
      },
      "typeVersion": 2
    },
    {
      "id": "preflight",
      "name": "Preflight",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        0
      ],
      "parameters": {
        "jsCode": "const env = $env;\nconst enabled = env.CAREER_ENABLED === 'true';\nconst dryRun = env.CAREER_DRY_RUN !== 'false';\nconst required = [\"JOBHUNT_SHEET_ID\", \"JOBHUNT_EMAIL_TO\", \"JOBHUNT_PROFILE\", \"JOBHUNT_SEARCH_URL\", \"JOBHUNT_ITEM_API_BASE\", \"CAREER_ALERT_EMAIL_TO\"];\nif (enabled && !dryRun) {\n  const missing = required.filter(key => !String(env[key] || '').trim());\n  if (missing.length) throw new Error('Missing configuration: ' + missing.join(', '));\n}\nconst runId = String($execution.id);\nconst status = !enabled ? 'disabled' : dryRun ? 'dry_run' : 'running';\nconsole.log(JSON.stringify({timestamp: new Date().toISOString(), runId, workflow: 'CAREER', status}));\nconst first = $input.first();\nreturn [{json: {...first.json, runId, status, runLive: status === 'running'}, ...(first.binary ? {binary: first.binary} : {})}];"
      }
    },

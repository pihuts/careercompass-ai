    {
      "id": "code-clean",
      "name": "Clean Job Text",
      "type": "n8n-nodes-base.code",
      "position": [
        3600,
        0
      ],
      "parameters": {
        "jsCode": "const results = [];\nfor (const item of $input.all()) {\n  const j = item.json || {};\n  let text = typeof j.text === 'string' ? j.text : JSON.stringify(j);\n  text = String(text)\n    .replace(/&#x2F;/g, '/')\n    .replace(/&#x27;/g, \"'\")\n    .replace(/&\\w+;/g, ' ')\n    .replace(/<[^>]*>/g, '')\n    .replace(/\\s+/g, ' ')\n    .trim();\n  results.push({ json: { cleaned_text: text, job_id: j.job_id } });\n}\nreturn results;"
      },
      "typeVersion": 2
    },

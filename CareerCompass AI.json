    {
      "id": "output-parser",
      "name": "Structured Output Parser",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "position": [2160, -200],
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\"type\":\"object\",\"properties\":{\"company\":{\"type\":[\"string\",\"null\"],\"description\":\"Hiring company name\"},\"title\":{\"type\":[\"string\",\"null\"],\"description\":\"Job title\"},\"location\":{\"type\":[\"string\",\"null\"],\"description\":\"Location including remote\"},\"type\":{\"type\":[\"string\",\"null\"],\"enum\":[\"FULL_TIME\",\"PART_TIME\",\"CONTRACT\",\"INTERNSHIP\",\"FREELANCE\",null],\"description\":\"Employment type\"},\"work_location\":{\"type\":[\"string\",\"null\"],\"enum\":[\"REMOTE\",\"HYBRID\",\"ON_SITE\",null],\"description\":\"Work arrangement\"},\"salary\":{\"type\":[\"string\",\"null\"],\"description\":\"Compensation\"},\"description\":{\"type\":[\"string\",\"null\"],\"description\":\"Job description\"},\"apply_url\":{\"type\":[\"string\",\"null\"],\"description\":\"Application URL\"},\"company_url\":{\"type\":[\"string\",\"null\"],\"description\":\"Company website\"},\"hn_item_id\":{\"type\":[\"string\",\"null\"],\"description\":\"Hacker News item id from JOB REFERENCE\"},\"email_subject\":{\"type\":[\"string\",\"null\"],\"description\":\"Short personalized application email subject\"},\"match_score\":{\"type\":[\"number\",\"null\"],\"description\":\"0-100 fit score\"},\"match_reasons\":{\"type\":[\"array\",\"null\"],\"items\":{\"type\":\"string\"},\"description\":\"3-5 specific reasons\"},\"missing_skills\":{\"type\":[\"array\",\"null\"],\"items\":{\"type\":\"string\"},\"description\":\"2-4 missing skills\"},\"cover_letter\":{\"type\":[\"string\",\"null\"],\"description\":\"120-180 word cover letter draft\"}},\"required\":[\"company\",\"title\",\"location\",\"type\",\"work_location\",\"salary\",\"description\",\"apply_url\",\"company_url\",\"hn_item_id\",\"email_subject\",\"match_score\",\"match_reasons\",\"missing_skills\",\"cover_letter\"]}"
      },
      "typeVersion": 1.2
    },
    {
      "id": "chain-score",
      "name": "Parse and Score Job",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "position": [1980, 0],
      "parameters": {
        "text": "={{ $json.jobText }}\n\n=== CANDIDATE PROFILE ===\n{{ $json.candidateProfile }}",
        "messages": {
          "messageValues": [
            {
              "message": "You are a strict technical recruiter and career coach. Extract the job details from the text into the provided JSON schema, using the JOB REFERENCE for hn_item_id. Then score the job 0-100 against the CANDIDATE PROFILE. Be strict: only give 75+ when the candidate clearly matches 70% or more of the required skills and the location/remote policy. Include 3-5 match reasons, 2-4 missing skills, a short personalized email subject, and a 120-180 word cover letter draft that uses only facts from the profile. Return valid JSON only."
            }
          ]
        },
        "promptType": "define",
        "hasOutputParser": true
      },
      "typeVersion": 1.5
    },
    {
      "id": "code-normalize",
      "name": "Normalize AI Output",
      "type": "n8n-nodes-base.code",
      "position": [2160, 0],
      "parameters": {
        "jsCode": "const items = $input.all();\nconst results = [];\nconst str = (v) => v === null || v === undefined ? '' : String(v);\nconst list = (v) => Array.isArray(v) ? v.map(str).join(' | ') : str(v);\nfor (const item of items) {\n  const raw = item.json.output || item.json;\n  results.push({\n    json: {\n      company: str(raw.company),\n      title: str(raw.title),\n      location: str(raw.location),\n      employment_type: str(raw.type),\n      work_location: str(raw.work_location),\n      salary: str(raw.salary),\n      description: str(raw.description),\n      apply_url: str(raw.apply_url),\n      company_url: str(raw.company_url),\n      hn_item_id: str(raw.hn_item_id),\n      email_subject: str(raw.email_subject),\n      match_score: Number(raw.match_score) || 0,\n      match_reasons: list(raw.match_reasons),\n      missing_skills: list(raw.missing_skills),\n      cover_letter: str(raw.cover_letter)\n    }\n  });\n}\nreturn results;"
      },
      "typeVersion": 2
    },
    {
      "id": "filter-strong",
      "name": "Strong Matches Only",
      "type": "n8n-nodes-base.filter",
      "position": [2340, 0],

    {
      "id": "code-digest",
      "name": "Build Digest",
      "type": "n8n-nodes-base.code",
      "position": [2340, 240],
      "parameters": {
        "jsCode": "const jobs = $input.all()\n  .map((i) => i.json)\n  .filter((j) => Number(j.match_score) >= 75)\n  .sort((a, b) => Number(b.match_score) - Number(a.match_score))\n  .slice(0, 10);\nreturn [{ json: { jobs: jobs, count: jobs.length } }];"
      },
      "typeVersion": 2
    },
    {
      "id": "gmail-digest",
      "name": "Email Daily Digest",
      "type": "n8n-nodes-base.gmail",
      "position": [2520, 240],
      "parameters": {
        "sendTo": "={{ $env.JOBHUNT_EMAIL_TO || 'your@email.com' }}",
        "subject": "=CareerCompass AI - {{ $json.count }} strong matches ({{ $now.format('dd MMM yyyy') }})",
        "message": "=<html><body style='font-family:Arial,sans-serif;background:#f6f8fa;padding:24px'><div style='max-width:640px;margin:0 auto;background:#ffffff;border-radius:8px;padding:24px'><h2 style='margin-top:0'>CareerCompass AI</h2><p><strong>{{ $json.count }}</strong> strong match(es) found today.</p>{{ $json.jobs.map(j => `<div style='border:1px solid #e1e4e8;border-radius:6px;padding:16px;margin:12px 0'><h3 style='margin:0 0 4px'><a href='${j.apply_url}'>${j.title}</a> @ ${j.company}</h3><p style='margin:4px 0'>Score: <strong>${j.match_score}/100</strong> | ${j.location} | ${j.work_location}</p><p style='margin:4px 0'><strong>Why:</strong> ${j.match_reasons}</p><p style='margin:4px 0'><strong>Missing skills:</strong> ${j.missing_skills || 'None'}</p><p style='margin:4px 0'><strong>Suggested subject:</strong> ${j.email_subject}</p><p style='margin:4px 0'><strong>Cover letter draft:</strong></p><blockquote style='margin:4px 0;padding:8px 12px;background:#f6f8fa;border-left:3px solid #2da44e'>${j.cover_letter}</blockquote></div>`).join('') || '<p>No strong matches today. Review your profile or lower the threshold.</p>'}</div></body></html>",
        "options": {},
        "emailType": "html"
      },
      "typeVersion": 2
    }
  ],
